# Read automatically by the mediabrain binary (real env vars take precedence).
DATABASE_URL=postgres://mediabrain:mediabrain@localhost:5432/mediabrain?sslmode=disable
# Loopback only: with DEBUG=true the server refuses any other address (see DEBUG_ALLOW_REMOTE).
HTTP_ADDR=127.0.0.1:8080
AUTO_MIGRATE=true
# Playground at / and schema introspection. Off by default.
GRAPHQL_PLAYGROUND=true
# Enables /debug/ (dev data UI) and lets requests act as any user without a token.
# NEVER enable in production.
DEBUG=true
# With DEBUG: requests that name no user act as this one. Created as an administrator when
# missing, so the playground and API clients work on an empty or freshly reset database.
DEBUG_USER=admin@example.test
# With DEBUG: allow HTTP_ADDR to be reachable from other machines (for example :8080 inside a
# container). Everyone who can reach it is then an administrator and can wipe the data.
# DEBUG_ALLOW_REMOTE=true

# Sign-in is done by a proxy in front of MediaBrain that forwards a signed JWT.
# All four are required unless DEBUG=true.
# AUTH_ISSUER=https://login.example.com
# AUTH_AUDIENCE=mediabrain
# AUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# Only these peers may call /query (comma-separated IPs or CIDR ranges).
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# Header carrying the JWT ("Bearer " prefix optional) and the claim listing the user's groups.
# AUTH_HEADER=Authorization
# AUTH_GROUPS_CLAIM=groups
# Vidispine, for importing assets. Optional; all three or none.
# VIDISPINE_URL is the root of the Vidispine API.
# VIDISPINE_URL=https://vidispine.example.com/API
# VIDISPINE_USERNAME=mediabrain
# VIDISPINE_PASSWORD=
# text | json
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=debug
