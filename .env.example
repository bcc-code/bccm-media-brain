# Read automatically by the mediabrain binary (real env vars take precedence).
DATABASE_URL=postgres://mediabrain:mediabrain@localhost:5432/mediabrain?sslmode=disable
# Loopback only: with DEBUG=true the server refuses any other address (see DEBUG_ALLOW_REMOTE).
HTTP_ADDR=127.0.0.1:8080
AUTO_MIGRATE=true
# Playground at / and schema introspection. Off by default.
GRAPHQL_PLAYGROUND=true
# Enables /debug/ (dev data UI) and lets requests act as any user without a token.
# NEVER enable in production.
DEBUG=true
# With DEBUG: requests that name no user act as this one. Created as an administrator when
# missing, so the playground and API clients work on an empty or freshly reset database.
DEBUG_USER=admin@example.test
# With DEBUG: allow HTTP_ADDR to be reachable from other machines (for example :8080 inside a
# container). Everyone who can reach it is then an administrator and can wipe the data.
# DEBUG_ALLOW_REMOTE=true

# Sign-in is done by a proxy in front of MediaBrain (Traefik with authentik's forward auth) that
# forwards a signed JWT. Issuer, audience, trusted proxies, user group and one of the secret and
# the key URL are required unless DEBUG=true.
# The issuer is compared exactly, trailing slash included. The audience is the client ID of
# the authentik proxy provider, which signs with its client secret (HS256) and publishes no keys.
# AUTH_ISSUER=https://auth.bcc.media/application/o/<app-slug>/
# AUTH_AUDIENCE=<client id of the proxy provider>
# AUTH_HS256_SECRET=<client secret of the proxy provider, at least 32 characters>
# For an issuer that publishes signing keys instead:
# AUTH_JWKS_URL=https://auth.bcc.media/application/o/<app-slug>/jwks/
# Only these peers may call /query (comma-separated IPs or CIDR ranges).
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# Header carrying the JWT ("Bearer " prefix optional) and the claim listing the user's groups.
# The other X-authentik-* headers are not signed and are not read.
# AUTH_HEADER=X-authentik-jwt
# Header in which the proxy reports its client's address, for the audit log. Set it only if the
# proxy overwrites the header: what a client sends in it would otherwise be logged as fact.
# AUTH_CLIENT_HEADER=X-Forwarded-For
# AUTH_GROUPS_CLAIM=groups
# Who is let in, by group. Members of the user group are people: they get an account at their
# first request, with no permissions. Required. Members of the service group are machine
# clients: each needs a service account created in advance (make service-create). Optional.
# A token with neither group is refused.
# AUTH_USER_GROUP=mediabrain-users
# AUTH_SERVICE_GROUP=mediabrain-services
# Vidispine, for importing assets. Optional; all three or none.
# VIDISPINE_URL is the root of the Vidispine API.
# VIDISPINE_URL=https://vidispine.example.com/API
# VIDISPINE_USERNAME=mediabrain
# VIDISPINE_PASSWORD=
# text | json
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=debug
