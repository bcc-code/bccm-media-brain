# Read automatically by the mediabrain binary (real env vars take precedence).
DATABASE_URL=postgres://mediabrain:mediabrain@localhost:5432/mediabrain?sslmode=disable
HTTP_ADDR=:8080
AUTO_MIGRATE=true
GRAPHQL_PLAYGROUND=true
# Enables /debug/ (dev data UI). NEVER enable in production.
DEBUG=true
# text | json
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=debug
