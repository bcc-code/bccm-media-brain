enum TrackKind {
  SUBTITLE
  CC
  TRANSCRIPT
}

enum TrackOrigin {
  IMPORT
  ASR
  MANUAL
}

enum SubtitleFormat {
  SRT
  VTT
  "Whisper JSON, as the transcriber writes it: segments with times in seconds and optional word timing."
  JSON
}

"One revision of a rendition's subtitles. Revisions are never changed; edits add a new one."
type SubtitleTrack {
  id: ID!
  renditionId: ID!
  assetId: ID!
  sourceFileId: ID
  language: String
  kind: TrackKind!
  origin: TrackOrigin!
  "Where the text came from: the speech recognition model of an ASR run (\"nb-whisper-large\") or the system it was taken from (\"Mediabanken\"). Edits have none."
  source: String
  model: String @deprecated(reason: "Use source.")
  revision: Int!
  "The revision this one replaced."
  parentId: ID
  createdBy: ID
  createdAt: Time!
  "At most 5000 per page."
  cues(first: Int = 500, after: String): SubtitleCueConnection!
  "The whole track as subtitle text. SRT drops speakers; only JSON keeps word timing."
  export(format: SubtitleFormat!): String!
}

type SubtitleCue {
  seq: Int!
  startMs: Int!
  endMs: Int!
  text: String!
  speaker: String
  "Word timing from speech recognition; null when the source had none. Words may overhang the cue."
  words: [SubtitleWord!]
}

type SubtitleWord {
  startMs: Int!
  endMs: Int!
  text: String!
  "Between 0 and 1, when the recognizer reported one."
  confidence: Float
}

input ImportSubtitlesInput {
  versionId: ID!
  "BCP 47 tag. Each language has its own subtitle rendition."
  language: String
  kind: TrackKind
  format: SubtitleFormat!
  "The subtitle file's text, at most 5 MB. With JSON, word timing is kept."
  content: String!
  "The registered file the text came from, if any. It is attached to the subtitle rendition, so the caller needs DOWNLOAD_ORIGINAL on it."
  sourceFileId: ID
  "IMPORT (the default) or ASR. MANUAL revisions come only from editSubtitles."
  origin: TrackOrigin
  "Where the text came from, e.g. \"nb-whisper-large\" or \"Mediabanken\". At most 200 characters."
  source: String
  "The old name of source; source wins when both are given."
  model: String @deprecated(reason: "Use source.")
}

input SubtitleCueInput {
  startMs: Int!
  endMs: Int!
  text: String!
  speaker: String
  "Kept as given; leave out when the text changed and the timing no longer fits. At most 1000."
  words: [SubtitleWordInput!]
}

input SubtitleWordInput {
  startMs: Int!
  endMs: Int!
  text: String!
  confidence: Float
}

extend type Query {
  subtitleTrack(id: ID!): SubtitleTrack
  subtitleTracks(assetId: ID!, history: Boolean! = false): [SubtitleTrack!]!
}

extend type Mutation {
  "Adds a new revision for the language on the version."
  importSubtitles(input: ImportSubtitlesInput!): SubtitleTrack!
  "Writes a new revision with exactly these cues. Only the latest revision can be edited."
  editSubtitles(trackId: ID!, cues: [SubtitleCueInput!]!): SubtitleTrack!
  deleteSubtitleTrack(id: ID!): Boolean!
}

"One page of the cues of a subtitle track."
type SubtitleCueConnection {
  nodes: [SubtitleCue!]!
  pageInfo: PageInfo!
}
