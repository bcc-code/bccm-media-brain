enum LinkRole {
  SOURCE
  DELIVERABLE
  REFERENCE
}

enum LinkOrigin {
  FOLDER
  MANUAL
}

enum VersionStatus {
  DRAFT
  REVIEW
  APPROVED
  FINAL
}

enum RenditionKind {
  MASTER
  ENCODE
  DUB
  SIGN
  SUBTITLE
  AUDIO
  OTHER
}

enum FileRole {
  VIDEO
  AUDIO
  SUBTITLE
  SIDECAR
  PACKAGE
}

enum LanguageModality {
  SPOKEN
  SIGNED
  NONE
  SPECIAL
}

type AssetType {
  id: Int!
  name: String!
  description: String
}

type Language {
  "BCP 47 tag."
  code: String!
  name: String!
  nativeName: String
  modality: LanguageModality!
  baseCode: String
  altCodes: [String!]!
  active: Boolean!
}

"The logical item, for example one camera clip or one finished programme."
type Asset {
  id: ID!
  "Counts the edits of this object's own fields, starting at 1. Send it back as expectedRevision when updating."
  revision: Int!
  typeId: Int!
  title: String!
  description: String
  capturedAt: Time
  camera: String
  reel: String
  metadata: JSON!
  legacyIds: [String!]!
  originalLanguage: String
  createdAt: Time!
  updatedAt: Time!
  type: AssetType!
  "The caller's permission level on this asset."
  myLevel: PermissionLevel!
  "By number, oldest first. At most 500 per page."
  versions(limit: Int = 50, offset: Int = 0): [AssetVersion!]!
  "Links to projects the caller may see. The others are left out, so an asset does not reveal a project."
  projects: [AssetProjectLink!]!
}

type AssetProjectLink {
  assetId: ID!
  projectId: ID!
  role: LinkRole!
  linkedBy: LinkOrigin!
  createdAt: Time!
  "Null only if the project stopped being visible while the request ran."
  project: Project
}

"One edit of an asset: rough cut, review 1, final."
type AssetVersion {
  id: ID!
  "Counts the edits of this object's own fields, starting at 1. Send it back as expectedRevision when updating."
  revision: Int!
  assetId: ID!
  number: Int!
  label: String
  status: VersionStatus!
  createdBy: ID
  createdAt: Time!
  updatedAt: Time!
  renditions: [Rendition!]!
}

"One concrete form of a version: master, encode, dub, subtitles."
type Rendition {
  id: ID!
  "Counts the edits of this object's own fields, starting at 1. Send it back as expectedRevision when updating."
  revision: Int!
  versionId: ID!
  kind: RenditionKind!
  language: String
  purpose: String
  overrides: JSON!
  metadata: JSON!
  createdAt: Time!
  updatedAt: Time!
  files: [RenditionFile!]!
  "The latest revision, or every revision with history."
  subtitleTracks(history: Boolean! = false): [SubtitleTrack!]!
}

type RenditionFile {
  renditionId: ID!
  fileId: ID!
  role: FileRole!
  position: Int!
  file: File!
}

input AssetInput {
  typeId: Int!
  title: String!
  description: String
  capturedAt: Time
  camera: String
  reel: String
  metadata: JSON
  legacyIds: [String!]
  originalLanguage: String
}

input AssetFilter {
  typeId: Int
  projectId: ID
  "Case-insensitive part of the title."
  title: String
  legacyId: String
}

input VersionInput {
  label: String
  status: VersionStatus
}

input CreateRenditionInput {
  kind: RenditionKind!
  language: String
  purpose: String
  overrides: JSON
  metadata: JSON
}

input UpdateRenditionInput {
  language: String
  purpose: String
  overrides: JSON
  metadata: JSON
}

extend type Query {
  assetTypes: [AssetType!]!
  languages(activeOnly: Boolean! = true): [Language!]!
  asset(id: ID!): Asset
  "Newest first."
  assets(filter: AssetFilter, limit: Int = 50, offset: Int = 0): [Asset!]!
  assetVersion(id: ID!): AssetVersion
  rendition(id: ID!): Rendition
}

extend type Mutation {
  "Needs EDIT on the project. Only administrators may leave projectId out."
  createAsset(projectId: ID, input: AssetInput!): Asset!
  """
  Replaces all editable fields: an optional field left out of the input is cleared.
  With expectedRevision the update is refused with CONFLICT when the object is no longer at
  that revision, so an edit cannot silently overwrite someone else's. Without it the last
  write wins; clients that edit interactively should always send it.
  """
  updateAsset(id: ID!, input: AssetInput!, expectedRevision: Int): Asset!
  "Removes the asset with its versions, renditions and subtitles. Files stay."
  deleteAsset(id: ID!): Boolean!
  "Needs EDIT on both the asset and the project."
  linkAssetToProject(assetId: ID!, projectId: ID!, role: LinkRole!): AssetProjectLink!
  unlinkAssetFromProject(assetId: ID!, projectId: ID!, role: LinkRole!): Boolean!
  createAssetVersion(assetId: ID!, input: VersionInput!): AssetVersion!
  """
  Replaces all editable fields: an optional field left out of the input is cleared, and a status left out becomes DRAFT.
  With expectedRevision the update is refused with CONFLICT when the object is no longer at
  that revision, so an edit cannot silently overwrite someone else's. Without it the last
  write wins; clients that edit interactively should always send it.
  """
  updateAssetVersion(id: ID!, input: VersionInput!, expectedRevision: Int): AssetVersion!
  deleteAssetVersion(id: ID!): Boolean!
  createRendition(versionId: ID!, input: CreateRenditionInput!): Rendition!
  """
  Replaces all editable fields: an optional field left out of the input is cleared.
  With expectedRevision the update is refused with CONFLICT when the object is no longer at
  that revision, so an edit cannot silently overwrite someone else's. Without it the last
  write wins; clients that edit interactively should always send it.
  """
  updateRendition(id: ID!, input: UpdateRenditionInput!, expectedRevision: Int): Rendition!
  deleteRendition(id: ID!): Boolean!
  "Needs EDIT on the rendition's asset and DOWNLOAD_ORIGINAL on the file: attaching shows where the file is stored to everyone who may download the asset."
  attachFile(renditionId: ID!, fileId: ID!, role: FileRole!, position: Int! = 0): RenditionFile!
  detachFile(renditionId: ID!, fileId: ID!, role: FileRole!): Boolean!
}
