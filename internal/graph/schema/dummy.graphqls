# PLACEHOLDER types — replace with the real media model.

type Dummy {
  id: ID!
  name: String!
  createdAt: Time!
}

extend type Query {
  dummy(id: ID!): Dummy
  dummies(limit: Int = 50, offset: Int = 0): [Dummy!]!
}

extend type Mutation {
  createDummy(name: String!): Dummy!
  deleteDummy(id: ID!): Boolean!
}
