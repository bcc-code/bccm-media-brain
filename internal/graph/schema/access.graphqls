"Ordered: each level includes the ones before it."
enum PermissionLevel {
  VIEW
  DOWNLOAD_ORIGINAL
  EDIT
  DELETE
  ADMIN
}

enum GrantScope {
  PROGRAM
  PROJECT
  ASSET
}

enum UserKind {
  PERSON
  "A machine client. Its token carries the service group, and it must have been created with createServiceAccount."
  SERVICE
}

type User {
  id: ID!
  kind: UserKind!
  externalId: String!
  email: String
  name: String
  active: Boolean!
  "System administrators bypass all grant checks."
  isAdmin: Boolean!
  createdAt: Time!
  "Sorted by name. Another user's groups are shown to administrators only; anyone else sees an empty list."
  groups: [UserGroup!]!
}

input UserFilter {
  kind: UserKind
  "Part of the name or email, in any case."
  search: String
}

type UserGroup {
  id: ID!
  name: String!
  "Set for groups that come from the identity provider."
  externalId: String
  description: String
}

"Access given to one user or one group on a program, project or asset."
type Grant {
  id: ID!
  scope: GrantScope!
  scopeId: ID!
  level: PermissionLevel!
  userId: ID
  groupId: ID
  grantedBy: ID
  grantedAt: Time!
  expiresAt: Time
}

input GrantInput {
  scope: GrantScope!
  scopeId: ID!
  "Exactly one of userId, userEmail and groupId."
  userId: ID
  userEmail: String
  groupId: ID
  level: PermissionLevel!
  expiresAt: Time
}

input ServiceAccountInput {
  "The account's username at the identity provider: its first sign-in is matched on it. Unique among service accounts."
  name: String!
  "System administrator. Needed for administrator-only operations such as registering files."
  admin: Boolean! = false
  "Id of an account that already signed in as a person and becomes this service account. Without it a new account is made, which signs in later."
  user: ID
}

extend type Query {
  me: User!
  "Administrators only, not service accounts."
  serviceAccounts: [User!]!
  "Administrators only."
  users(filter: UserFilter, first: Int = 50, after: String): UserConnection!
  "Administrators only."
  userGroups: [UserGroup!]!
  "Needs ADMIN on the object."
  grants(scope: GrantScope!, scopeId: ID!): [Grant!]!
}

extend type Mutation {
  "Needs ADMIN on the object."
  grantAccess(input: GrantInput!): Grant!
  revokeAccess(id: ID!): Boolean!
  "Administrators only, not service accounts. user is a user id or email."
  setUserAdmin(user: String!, admin: Boolean!): User!
  "Administrators only, not service accounts. People only (user is a user id or email); not your own account. An inactive person is refused. Takes up to a minute to apply."
  setUserActive(user: String!, active: Boolean!): User!
  "Administrators only, not service accounts."
  createServiceAccount(input: ServiceAccountInput!): User!
  "Administrators only, not service accounts. An inactive account is refused. Takes up to a minute to apply."
  setServiceAccountActive(serviceAccount: String!, active: Boolean!): User!
}

"One page of users."
type UserConnection {
  nodes: [User!]!
  pageInfo: PageInfo!
}
