# Settings read by docker-compose.prod.yml. Copy to .env.prod and fill in.

# Password of the bundled Postgres. It goes into a URL as is: letters and digits only, or
# percent-encode it.
POSTGRES_PASSWORD=
# Only for a database outside the compose file. The bundled postgres service still starts and
# still needs POSTGRES_PASSWORD; remove the service if you do not want it.
# MEDIABRAIN_DATABASE_URL=postgres://user:password@host:5432/mediabrain?sslmode=require&pool_max_conns=10

MEDIABRAIN_TAG=latest
MEDIABRAIN_REPLICAS=2
LOG_LEVEL=info

# Sign-in: the proxy in front forwards a signed JWT. All three are required.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Peers that may call /query. Defaults to the compose network (172.30.80.0/24).
# AUTH_TRUSTED_PROXIES=
# AUTH_HEADER=Authorization
# AUTH_GROUPS_CLAIM=groups

# Vidispine import. Optional; all three or none.
# VIDISPINE_URL=
# VIDISPINE_USERNAME=
# VIDISPINE_PASSWORD=
