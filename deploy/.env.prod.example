# Settings read by docker-compose.prod.yml. Copy to .env.prod and fill in.

# Password of the bundled Postgres. It goes into a URL as is: letters and digits only, or
# percent-encode it.
POSTGRES_PASSWORD=
# Only for a database outside the compose file. The bundled postgres service still starts and
# still needs POSTGRES_PASSWORD; remove the service if you do not want it.
# MEDIABRAIN_DATABASE_URL=postgres://user:password@host:5432/mediabrain?sslmode=require&pool_max_conns=10

MEDIABRAIN_TAG=latest
MEDIABRAIN_REPLICAS=2
LOG_LEVEL=info

# Sign-in: the proxy in front (Traefik with authentik's forward auth) forwards a signed JWT.
# The three below and AUTH_USER_GROUP are required. The issuer is compared exactly, trailing slash included:
#   AUTH_ISSUER=https://auth.bcc.media/application/o/<app-slug>/
#   AUTH_AUDIENCE=<client id of the authentik proxy provider>
#   AUTH_JWKS_URL=https://auth.bcc.media/application/o/<app-slug>/jwks/
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Who is let in, by authentik group. Members of the user group are people: they get an account
# at their first request, with no permissions. Required. Members of the service group are
# machine clients: each needs a service account created in advance (`mediabrain service create`).
# A token with neither group is refused.
AUTH_USER_GROUP=
# AUTH_SERVICE_GROUP=
# Peers that may call /query. Defaults to the compose network (172.30.80.0/24).
# AUTH_TRUSTED_PROXIES=
# AUTH_HEADER=X-authentik-jwt
# Header in which the proxy reports its client's address, for the audit log. Set it only if the
# proxy overwrites the header: what a client sends in it would otherwise be logged as fact.
# AUTH_CLIENT_HEADER=X-Forwarded-For
# AUTH_GROUPS_CLAIM=groups

# Vidispine import. Optional; all three or none.
# VIDISPINE_URL=
# VIDISPINE_USERNAME=
# VIDISPINE_PASSWORD=
